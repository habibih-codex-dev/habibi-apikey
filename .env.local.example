# ============================================================
#  Habibi Dashboard (full-stack) — local dev env
#  Copy to .env.local. On Vercel, set these in Project ▸ Settings ▸ Env Vars.
# ============================================================

# --- Leave blank: API is same-origin (/api/*) ---
NEXT_PUBLIC_API_URL=

# --- Admin login ---
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=habibi123

# --- API key quota ---
APIKEY_DAILY_QUOTA=1000

# --- Database (Upstash Redis) ---
# On Vercel: add "Upstash for Redis" in the Storage tab and these are set automatically.
# For local dev, create a free Upstash DB and paste its REST creds here:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional providers (downloaders / search / AI) ---
OPENAI_API_KEY=
UPSTREAM_TIKTOK_URL=
UPSTREAM_YTMP3_URL=
UPSTREAM_YTMP4_URL=
UPSTREAM_IG_URL=
UPSTREAM_FB_URL=
UPSTREAM_TWITTER_URL=
UPSTREAM_CAPCUT_URL=
UPSTREAM_THREADS_URL=
UPSTREAM_SNACK_URL=
UPSTREAM_SPOTIFY_URL=
UPSTREAM_MEDIAFIRE_URL=
UPSTREAM_GDRIVE_URL=
UPSTREAM_GOOGLE_URL=
UPSTREAM_IMAGE_URL=
UPSTREAM_PINTEREST_URL=
